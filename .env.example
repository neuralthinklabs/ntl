# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# The app uses `prepare: false`, which is what the pooler requires.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:password@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key
EMAIL_FROM="Neural Think Labs <hello@yourdomain.org>"
# Where contact messages, new problems and new pledges are announced:
CONTACT_INBOX_EMAIL=hello@yourdomain.org

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Forms ---
NEXT_PUBLIC_VOLUNTEER_FORM_URL=https://forms.gle/your-google-form-id
# Optional quick-path shown above the native problem form:
NEXT_PUBLIC_PROBLEM_FORM_URL=

# --- Payments (manual until a processor is added) ---
# Shown to people in the pledge confirmation email. Plain text, e.g.
# "Bank transfer to ACME Trust, A/C 1234, IFSC XXXX. Quote your pledge reference."
PAYMENT_INSTRUCTIONS=

# --- Social links (footer + contact page). Leave blank to hide an icon. ---
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Scheduled cleanup route ---
CRON_SECRET=generate-a-long-random-string

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- NTL ID provider (server only, never expose to the browser) ---
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=
