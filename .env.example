# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings -> Database -> Connection string (use the "Transaction" pooler URI for serverless)
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key
EMAIL_FROM="Neural Think Labs <hello@yourdomain.org>"
CONTACT_INBOX_EMAIL=hello@yourdomain.org

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Volunteer application (Phase A placeholder) ---
NEXT_PUBLIC_VOLUNTEER_FORM_URL=https://forms.gle/your-google-form-id

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
